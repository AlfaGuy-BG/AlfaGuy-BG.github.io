{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "description": "Georgi Krastev's QA portfolio: a static page that tests itself.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "fonts": "node tools/copy_fonts.mjs",
    "csp": "node tools/csp.mjs",
    "scan": "node tools/prepublish_scan.mjs site",
    "test:unit": "node --test tests/scan.test.mjs tests/csp.test.mjs tests/ai_reader.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run scan && npm run test:e2e",
    "ai-reader": "node tools/ai_reader_eval.mjs",
    "og": "node tools/make_og.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.0.0",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
