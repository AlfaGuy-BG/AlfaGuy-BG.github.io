{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "description": "Georgi Krastev's QA portfolio: a static page that tests itself.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "scan": "node tools/prepublish_scan.mjs site",
    "test:scan": "node --test tests/scan.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:scan && npm run scan && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0"
  },
  "engines": { "node": ">=20" }
}
